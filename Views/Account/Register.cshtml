@model RegisterVm
@{ViewData["Title"]="Create account";}
<div class="form-page"><div class="form-card wide"><span class="eyebrow">BECOME PART OF IT</span><h2>Create your account</h2><p class="muted">One account. Every finish line.</p><form method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid"><div><label asp-for="FirstName"></label><input asp-for="FirstName"/></div><div><label asp-for="LastName"></label><input asp-for="LastName"/></div><div class="span2"><label asp-for="Email"></label><input asp-for="Email"/></div><div class="span2"><label asp-for="Password"></label><input asp-for="Password"/></div><div class="span2"><label asp-for="Role">Account type</label><select asp-for="Role"><option>Participant</option><option>Organiser</option></select></div><div class="span2" id="organiser-code"><label asp-for="OrganiserCode"></label><input asp-for="OrganiserCode" placeholder="Required for organiser accounts"/></div></div><button class="btn btn-primary full">Create account →</button></form><p class="form-foot">Already registered? <a asp-action="Login">Sign in</a></p></div></div>
@section Scripts{<script>const role=document.getElementById('Role'),code=document.getElementById('organiser-code');function toggle(){code.style.display=role.value==='Organiser'?'block':'none'}role.addEventListener('change',toggle);toggle();</script>}
