@model CategoryVm
@{ViewData["Title"]="Event categories";var ev=ViewBag.Event as RaceEventDto;var cats=ViewBag.Categories as List<CategoryDto>??new();}
<div class="backlink"><a asp-action="Index">← Dashboard</a></div><div class="page-head"><div><span class="eyebrow">EVENT SETUP</span><h1>Categories</h1><p class="muted">@ev?.Name</p></div></div><div class="two-col"><section class="panel"><h2>Add a category</h2><form asp-action="AddCategory" asp-route-id="@ev?.EventId" method="post"><label asp-for="Name">Category name</label><input asp-for="Name" placeholder="e.g. Under 20 or 10km"/><label asp-for="CategoryType">Category type</label><select asp-for="CategoryType"><option>Age</option><option>Distance</option></select><button class="btn btn-primary">Add category</button></form></section><section class="panel"><h2>Available categories</h2>@foreach(var c in cats){<div class="category-row"><div><b>@c.Name</b><small>@c.CategoryType</small></div><form asp-action="DeleteCategory" asp-route-id="@ev?.EventId" asp-route-categoryId="@c.CategoryId" method="post"><button class="link-danger">Remove</button></form></div>}@if(cats.Count==0){<p class="muted">No categories yet.</p>}</section></div>
