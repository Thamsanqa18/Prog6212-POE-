@model RaceEventDto
@{ViewData["Title"]=Model.Name;var cats=ViewBag.Categories as List<CategoryDto>??new();var heroStyle=string.IsNullOrWhiteSpace(Model.BannerImageUrl)?"":$"background-image:linear-gradient(90deg,#193b32ef,#193b3270),url(\'{Model.BannerImageUrl}\');background-size:cover;background-position:center";}
<div class="backlink"><a asp-action="Index">← All events</a></div><section class="detail-hero" style="@heroStyle"><span class="eyebrow">@Model.EventType EVENT</span><h1>@Model.Name</h1><p>@Model.Description</p><div class="detail-stats"><div><small>DATE & TIME</small><b>@Model.EventDate.ToString("dd MMM yyyy · HH:mm")</b></div><div><small>LOCATION</small><b>@Model.Location</b></div><div><small>DISTANCE</small><b>@Model.DistanceKm km</b></div></div></section>
<div class="two-col"><section class="panel"><span class="eyebrow">CHOOSE YOUR DIVISION</span><h2>Available categories</h2>@if(cats.Count==0){<p>No categories have been added yet.</p>}else{<div class="category-list">@foreach(var c in cats){<div><span>@c.Name</span><small>@c.CategoryType</small></div>}</div>}</section><aside class="panel dark-panel"><span class="eyebrow">READY WHEN YOU ARE</span><h2>Your next finish line starts here.</h2>@if(Context.Session.GetString("Role")=="Participant"){<a class="btn btn-primary" asp-controller="Participant" asp-action="Enrol" asp-route-id="@Model.EventId">Enrol now →</a>}else if(string.IsNullOrEmpty(Context.Session.GetString("Role"))){<a class="btn btn-primary" asp-controller="Account" asp-action="Login">Sign in to enrol →</a>}else{<p>Organiser accounts cannot enrol in events.</p>}</aside></div>
