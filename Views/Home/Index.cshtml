@model List<RaceEventDto>
@{ViewData["Title"]="Discover events";}
<section class="hero"><div class="hero-copy"><span class="eyebrow">YOUR NEXT START LINE</span><h1>Find your pace.<br/><em>Own your race.</em></h1><p>Discover running, walking and cycling events. Pick your challenge, meet your community and make race day yours.</p><a class="btn btn-light" href="#events">Explore events <span>↘</span></a></div><div class="hero-art"><div class="sun"></div><div class="runner">↗</div><div class="hero-note">ONE MORE<br/>KILOMETRE.</div></div></section>
<section id="events" class="section"><div class="section-heading"><div><span class="eyebrow">ON THE CALENDAR</span><h2>Upcoming events</h2></div><form method="get" class="filter"><select name="type" onchange="this.form.submit()"><option value="">All disciplines</option><option selected="@(ViewBag.Type=="Run")" value="Run">Running</option><option selected="@(ViewBag.Type=="Walk")" value="Walk">Walking</option><option selected="@(ViewBag.Type=="Cycle")" value="Cycle">Cycling</option></select></form></div>
@if(Model.Count==0){<div class="empty"><h3>No upcoming events found</h3><p>Check back soon or change your filter.</p></div>}else{<div class="event-grid">@foreach(var e in Model){<article class="event-card"><div class="event-visual @e.EventType.ToLower()"><span class="event-type">@e.EventType</span><span class="visual-number">@e.DistanceKm.ToString("0.##")<small>KM</small></span><span class="visual-lines"></span></div><div class="event-content"><div class="event-date">@e.EventDate.ToString("ddd, dd MMM yyyy · HH:mm")</div><h3>@e.Name</h3><p>⌖ @e.Location</p><div class="card-bottom"><span>@e.OrganiserName</span><a asp-action="Details" asp-route-id="@e.EventId">View event ↗</a></div></div></article>}</div>}
</section>
